FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium chromium-sandbox xvfb xauth fonts-liberation ca-certificates tini && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY tools/auto-apply/package.json tools/auto-apply/package-lock.json ./tools/auto-apply/
RUN npm ci --prefix tools/auto-apply --ignore-scripts --omit=dev --no-audit --no-fund
COPY tools/auto-apply/*.js ./tools/auto-apply/
COPY lib/services/autoApply/portals.js ./lib/services/autoApply/portals.js
RUN mkdir -p /conf/browser-profiles && chown -R node:node /conf/browser-profiles /app
USER node
ENV CHROME_PATH=/usr/bin/chromium FREDY_BROWSER_PROFILE_DIR=/conf/browser-profiles
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["xvfb-run", "-a", "node", "tools/auto-apply/worker.js"]
